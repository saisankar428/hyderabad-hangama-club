APP_NAME=Hyderabad Hangama Club
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-32-char-secret-minimum-length

# Local Docker Postgres (disable SSL for local)
DATABASE_URL=postgresql+asyncpg://hangama:hangama_secret@127.0.0.1:5432/hangama
DATABASE_SSL=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Supabase (production — copy from supabase-env-example.txt)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=payment-screenshots

# Public API URL (required in production for WhatsApp QR links)
API_BASE_URL=

CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

ADMIN_API_KEY=supersecretadminkey
ADMIN_DASHBOARD_URL=http://127.0.0.1:3000/admin
ADMIN_WHATSAPP_NUMBER=
ADMIN_EMAIL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Hyderabad Hangama Club

AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=ticket_confirmation
ADMIN_AISENSY_CAMPAIGN_NAME_ADMIN=admin_payment_alert

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

PAYMENT_MODE=UPI_MANUAL
UPI_ID=yourname@upi
UPI_MERCHANT_NAME=Hyderabad Hangama Club
