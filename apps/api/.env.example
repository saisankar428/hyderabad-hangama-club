APP_NAME=Hyderabad Hangama Club
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-32-char-secret

DATABASE_URL=postgresql+asyncpg://hangama:hangama_secret@db:5432/hangama
REDIS_URL=redis://redis:6379/0

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=rzp_test_secret
RAZORPAY_WEBHOOK_SECRET=whsec_test_secret

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Hyderabad Hangama Club

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

AISENSY_API_KEY=your_aisensy_api_key
AISENSY_CAMPAIGN_NAME=ticket_confirmation

# Public base URL of this API — required for QR code attachment in WhatsApp
# e.g. https://api.yourdomain.com  (no trailing slash)
API_BASE_URL=

ADMIN_API_KEY=supersecretadminkey

# Admin notifications — sent when a customer submits payment proof
ADMIN_WHATSAPP_NUMBER=919876543210
ADMIN_EMAIL=admin@example.com
ADMIN_AISENSY_CAMPAIGN_NAME_ADMIN=admin_payment_alert
ADMIN_DASHBOARD_URL=https://yourdomain.com/admin

# Payment mode — change this single variable to switch providers.
# RAZORPAY   : online checkout via Razorpay SDK (requires RAZORPAY_KEY_* above)
# UPI_MANUAL : UPI QR + attendee submits UTR + admin approves (requires UPI_ID below)
PAYMENT_MODE=UPI_MANUAL
UPI_ID=yourname@upi
UPI_MERCHANT_NAME=Hyderabad Hangama Club
