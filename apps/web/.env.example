# Local development — copy to .env.local
# Production (Vercel): set the same keys in Vercel → Settings → Environment Variables

# REQUIRED in production — public HTTPS URL of your deployed FastAPI API
# e.g. https://hyderabad-hangama-api.onrender.com  (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Must match ADMIN_API_KEY in apps/api/.env
NEXT_PUBLIC_ADMIN_KEY=supersecretadminkey

# Razorpay — only if PAYMENT_MODE=RAZORPAY on the API
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# UPI — should match UPI_ID in apps/api/.env (client-side QR fallback)
NEXT_PUBLIC_UPI_ID=merchant@bankname
